    <decisions>
        <name>FTEs_to_Hire_Check</name>
        <label>FTEs to Hire Check</label>
        <locationX>666</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>FTEs_5_Assign_PS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.of_TMs_planned_to_hire_formula__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opp_Record_Type_Check_PS</targetReference>
            </connector>
            <label>FTEs &gt;= 5 (Assign PS)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Months_Since_First_Assisted_Setup_Date_Check</name>
        <label>Months Since First Assisted Setup Date Check</label>
        <locationX>930</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Months_0_1_or_2</name>
            <conditionLogic>(1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.Months_Since_First_Assisted_Setup_Date__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account.Months_Since_First_Assisted_Setup_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account.Months_Since_First_Assisted_Setup_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FTEs_to_Hire_Check</targetReference>
            </connector>
            <label>Months = 0, 1, or 2 (or blank)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Opp_Record_Type_Check_PS</name>
        <label>Opp Record Type Check (PS)</label>
        <locationX>402</locationX>
        <locationY>863</locationY>
        <defaultConnector>
            <targetReference>Create_Flow_Log_PS</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Initial_Opp_PS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Initial_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_to_PS_SRR</targetReference>
            </connector>
            <label>Initial Opp (PS)</label>
        </rules>
        <rules>
            <name>Subsequent_Opp_PS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Expansion_Upsell</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Initial_Opp_PS</targetReference>
            </connector>
            <label>Subsequent Opp (PS)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Owner_Role_Check</name>
        <label>Owner Role Check</label>
        <locationX>1194</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Owner_Role_Contains_AE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Owner.UserRole.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>AE</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account</targetReference>
            </connector>
            <label>Owner Role Contains AE</label>
        </rules>
    </decisions>
    <description>Assigns a Product Specialist automatically.
