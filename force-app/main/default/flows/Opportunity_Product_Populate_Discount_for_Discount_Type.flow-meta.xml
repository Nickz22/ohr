<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <decisions>
        <name>Discount_Type_Check</name>
        <label>Discount Type Check</label>
        <locationX>578</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>test</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Discount_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>2022 Year End Promo - $699 countries only</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Discount_to_16</targetReference>
            </connector>
            <label>2022 Year End Promo - $699 countries only</label>
        </rules>
        <rules>
            <name>Partner_Buy_2_1_Free</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Discount_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partner Buy 2 / 1 Free</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Discount_and_Discount_Duration</targetReference>
            </connector>
            <label>Partner Buy 2 / 1 Free</label>
        </rules>
        <rules>
            <name>X399_Price_Lock</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Discount_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>$399 Price Lock</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Price_Lock_Discount_Fields</targetReference>
            </connector>
            <label>$399 Price Lock</label>
        </rules>
        <rules>
            <name>Partnerships_Discount_20</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Discount_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partnerships Discount - 20%</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Partnerships_Discount_discount_fields</targetReference>
            </connector>
            <label>Partnerships Discount - 20%</label>
        </rules>
    </decisions>
    <description>Sets Discount fields based on Discount Type
2023-05-08: updated to include &quot;Partnerships Discount - 20%&quot;</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Product - Populate Discount for {!$Flow.CurrentDateTime}</interviewLabel>
