    <start>
        <locationX>452</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Discount_Type_Check</targetReference>
        </connector>
        <filterFormula>(ISNEW() &amp;&amp; NOT(ISBLANK(TEXT({!$Record.Discount_Type__c}))))
||
ISCHANGED({!$Record.Discount_Type__c})</filterFormula>
        <object>OpportunityLineItem</object>
