    <formulas>
        <name>fx_numOfProSRequests</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_Opportunity.Product_Specialist_Requests__c},0) + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fx_opportunityUrl</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_550}, FIND( &quot;/services&quot;, {!$Api.Partner_Server_URL_550})) &amp; {!recordId}</expression>
    </formulas>
