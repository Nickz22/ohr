    <description>Sets opportunity record type on creation and when it is closed won</description>
    <environments>Default</environments>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>Stage should be Prospecting if opp is created by BDR
Stage should be Discovery if opp is created by AE
Otherwise leave stage as is</description>
        <name>newInitialStageName</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!$Record.CreatedBy.UserRole.Name},&quot;AE&quot;) || CONTAINS({!$Record.CreatedBy.UserRole.Name},&quot;Sales Manager&quot;), &quot;Discovery&quot;,
IF({!$Record.CreatedBy.Profile.Name} = &quot;BDR User&quot; || {!$Record.CreatedBy.Profile.Name} = &quot;Inbound BDR&quot; || {!$Record.CreatedBy.Profile.Name} = &quot;Inside Sales Rep&quot;,
&quot;Prospecting&quot;,
TEXT({!$Record.StageName})
)
)</expression>
    </formulas>
    <formulas>
        <description>When an existing open opp is changed to Subsequent, change its stage to Validation only if its current stage is Prospecting or Discovery.  Otherwise keep the stage name the same</description>
        <name>newSubsequentStageName</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!Loop_Through_Open_Opps.StageName},&quot;Prospecting&quot;) || ISPICKVAL({!Loop_Through_Open_Opps.StageName},&quot;Discovery&quot;),
&quot;Validation&quot;,
TEXT({!Loop_Through_Open_Opps.StageName})
)</expression>
    </formulas>
