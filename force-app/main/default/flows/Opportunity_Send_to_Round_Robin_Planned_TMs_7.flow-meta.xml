<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <description>Feb 2023: Flow will no longer run if Owner was updated by a BDR
Sends an opportunity to SRR for routing when # of TMs Planned to Hire &gt;= 5.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity - Send to Round Robin - Planned TMs &gt;= 5 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Send to Round Robin - Planned TMs &gt;= 5</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Flow_Log</name>
        <label>Create Flow Log</label>
        <locationX>176</locationX>
        <locationY>455</locationY>
        <inputAssignments>
            <field>Flow_Name__c</field>
            <value>
                <stringValue>Opportunity - Send to Round Robin - Planned TMs &gt;= 5</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Record_ID__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>User__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Flow_Log__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Send_to_SRR</name>
        <label>Send to SRR</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <connector>
            <targetReference>Create_Flow_Log</targetReference>
        </connector>
        <inputAssignments>
            <field>Round_Robin_Assignment_Field__c</field>
            <value>
                <stringValue>Owner</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>leadassist__Use_Round_Robin__c</field>
            <value>
                <stringValue>TRUE</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_to_SRR</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3) AND 4 AND 5 AND 6</filterLogic>
        <filters>
            <field>of_TMs_planned_to_hire_formula__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>5.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Region__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>AMER</stringValue>
            </value>
        </filters>
        <filters>
            <field>Region__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>EMEA</stringValue>
            </value>
        </filters>
        <filters>
            <field>Created_by_Profile__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Inbound BDR</stringValue>
            </value>
        </filters>
        <filters>
            <field>OwnerId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Owner_Changed_by_BDR__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <triggerOrder>10</triggerOrder>
</Flow>
