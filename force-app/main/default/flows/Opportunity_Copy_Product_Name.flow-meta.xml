<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <decisions>
        <name>Filter_Out_EOR_Products</name>
        <label>Filter Out EOR Products</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>Copy_Product_Name_non_EOR</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non-EOR Products</defaultConnectorLabel>
        <rules>
            <name>EOR_Products</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Product_Name__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Tier</stringValue>
                </rightValue>
            </conditions>
            <label>EOR Products</label>
        </rules>
    </decisions>
    <decisions>
        <name>How_Many_EOR_Products</name>
        <label>How Many EOR Products?</label>
        <locationX>248</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Copy_Product_Name</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No EOR Products</defaultConnectorLabel>
        <rules>
            <name>Contains_EOR_Products</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.of_EOR_Products__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Product_Name_to_EOR</targetReference>
            </connector>
            <label>Contains EOR Products</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Opportunity - Copy Product Name {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Copy Product Name</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Copy_Product_Name</name>
        <label>Copy Product Name</label>
        <locationX>446</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Product_Name_Copy__c</field>
            <value>
                <elementReference>$Record.Product_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Copy_Product_Name_non_EOR</name>
        <label>Copy Product Name non EOR</label>
        <locationX>182</locationX>
        <locationY>611</locationY>
        <inputAssignments>
            <field>Product_Name_Copy__c</field>
            <value>
                <elementReference>$Record.Product_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Product_Name_to_EOR</name>
        <label>Product Name to EOR</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <connector>
            <targetReference>Filter_Out_EOR_Products</targetReference>
        </connector>
        <inputAssignments>
            <field>Product_Name_Copy__c</field>
            <value>
                <stringValue>EOR</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>122</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>How_Many_EOR_Products</targetReference>
        </connector>
        <filterFormula>(ISNEW() &amp;&amp; NOT(ISBLANK({!$Record.Product_Name__c})))
|| ISCHANGED({!$Record.Product_Name__c})</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
