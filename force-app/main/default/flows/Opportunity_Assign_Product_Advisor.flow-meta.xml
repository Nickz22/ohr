    <decisions>
        <name>Check_FTEs_Planned_to_Hire_and_Months_Since_FASD</name>
        <label>Check FTEs Planned to Hire and Months Since FASD</label>
        <locationX>611</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Flow_Complete_Not_Assigned</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Criteria Not Met</defaultConnectorLabel>
        <rules>
            <name>FTEs_1_or_2_and_Months_Since_FASD_0_2</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.of_TMs_planned_to_hire_formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity.of_TMs_planned_to_hire_formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account.Months_Since_First_Assisted_Setup_Date__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account.Months_Since_First_Assisted_Setup_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account.Months_Since_First_Assisted_Setup_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Region_Check</targetReference>
            </connector>
            <label>FTEs = 1 or 2 and Months Since FASD = 0-2</label>
        </rules>
    </decisions>
