        <field>Opportunity.Deal_Complexity__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Deal Complexity Win Rates by AE</name>
    <params>
        <name>open</name>
        <value>closed</value>
    </params>
    <params>
        <name>probability</name>
        <value>&gt;0</value>
