    <description>Account owners incorrect as still owned by BDR or AE after 3 months from first set up</description>
    <filter>
        <criteriaItems>
            <column>ROLLUP_DESCRIPTION</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>AE,BDR</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Months_Since_First_Assisted_Setup_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>3</value>
        </criteriaItems>
    </filter>
