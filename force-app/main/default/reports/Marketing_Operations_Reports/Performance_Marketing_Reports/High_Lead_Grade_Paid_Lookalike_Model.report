    <columns>
        <field>Lead.MK_Lead_Grade_Score__c</field>
    </columns>
    <columns>
        <field>EMAIL</field>
    </columns>
    <description>A report of the leads with the highest MK Lead Grade Score used to build lookalike models on our paid channels.
Lead Grade Score &gt;=72</description>
    <filter>
        <criteriaItems>
            <column>Lead.MK_Lead_Grade_Score__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>72</value>
        </criteriaItems>
    </filter>
    <format>Tabular</format>
    <name>High Lead Grade: Paid Lookalike Model</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>OpportunityLead</reportType>
    <scope>org</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <sortColumn>Lead.MK_Lead_Grade_Score__c</sortColumn>
    <sortOrder>Desc</sortOrder>
    <timeFrameFilter>
        <dateColumn>CREATED_DATE</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
