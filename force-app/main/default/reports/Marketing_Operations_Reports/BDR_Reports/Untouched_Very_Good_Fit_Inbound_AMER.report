    <description>&quot;Very Good/ Good&quot; Customer Fit inbound Americas Leads that are still in a &quot;New&quot; Lead Status.
Includes leads created &quot;Today&quot; and &quot;Yesterday.&quot;</description>
    <filter>
        <booleanFilter>1 AND 2 AND 4 AND 3 AND 5</booleanFilter>
        <criteriaItems>
            <column>STATUS</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>New</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.MK_Customer_Fit_Segment__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>very good,good</value>
        </criteriaItems>
        <criteriaItems>
            <column>CREATED_DATE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
