    <description>New and existing ICP accounts that have high-intent engagement, and need to be assigned to a BDR.</description>
    <filter>
        <booleanFilter>1 AND 2 AND 4 AND ((5 AND 6) AND (3 OR 7))</booleanFilter>
        <criteriaItems>
            <column>ACCOUNT_SOURCE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>contains</operator>
            <value>G2</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.mk_customer_fit_segment__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>good,very good</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.mk_customer_fit_signals__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Company is currently hiring</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.mk_customer_fit_signals__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>$10 million to $100 million,$1m to $10m</value>
        </criteriaItems>
        <criteriaItems>
            <column>EMPLOYEES</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>20</value>
        </criteriaItems>
        <criteriaItems>
            <column>EMPLOYEES</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>lessOrEqual</operator>
            <value>700</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.mk_customer_fit_signals__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Company raised</value>
        </criteriaItems>
    </filter>
