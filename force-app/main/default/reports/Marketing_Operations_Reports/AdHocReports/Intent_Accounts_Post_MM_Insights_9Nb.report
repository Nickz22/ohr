    <customDetailFormulas>
        <calculatedFormula>IF(
    ISPICKVAL(Account.Intent_Source__c, &apos;Clearbit - MM&apos;) || 
    ISPICKVAL(Account.Intent_Source__c, &apos;Clearbit - SMB&apos;) ,
    &apos;Clearbit&apos;,
    IF(
     ISPICKVAL(Account.Intent_Source__c, &apos;G2 - MM&apos;)  || 
         ISPICKVAL(Account.Intent_Source__c, &apos;G2 - SMB&apos;),
        &apos;G2&apos;,
        &apos;Clearbit&apos;
    )
)</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Intent Type</label>
        <scale>2</scale>
    </customDetailFormulas>
    <filter>
        <criteriaItems>
            <column>Account.Intent_Eligible_for_Distribution__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Intent_Source__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Clearbit - MM,G2 - MM</value>
        </criteriaItems>
    </filter>
