<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>Opportunity.Amount_Won__c:SUM*12</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>cARR</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>Opportunity.CreatedDate:UNIQUE-Campaign.StartDate:UNIQUE</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Speed to Opp</masterLabel>
        <scale>0</scale>
    </aggregates>
    <columns>
        <field>Campaign.AccountCampaignMembers$Name</field>
    </columns>
    <columns>
        <field>Campaign.AccountCampaignMembers.Opportunities$Owner</field>
    </columns>
    <columns>
        <field>Campaign.AccountCampaignMembers.Opportunities$Name</field>
    </columns>
    <columns>
        <field>Campaign.AccountCampaignMembers$Industry</field>
    </columns>
    <columns>
        <field>Campaign.AccountCampaignMembers.Opportunities$StageName</field>
    </columns>
    <columns>
        <field>Campaign.AccountCampaignMembers.Opportunities$CreatedDate</field>
    </columns>
    <columns>
        <field>Campaign.AccountCampaignMembers.Opportunities$CloseDate</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <aggregateTypes>Average</aggregateTypes>
        <field>Campaign.AccountCampaignMembers.Opportunities$Amount</field>
    </columns>
    <columns>
        <aggregateTypes>Average</aggregateTypes>
        <field>CDF1</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula>Opportunity.CloseDate - DATEVALUE(Opportunity.CreatedDate)</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Speed-to-Won</label>
        <scale>0</scale>
    </customDetailFormulas>
    <filter>
        <criteriaItems>
            <column>Campaign$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Retargeting Test</value>
        </criteriaItems>
        <criteriaItems>
            <column>Campaign.AccountCampaignMembers.Opportunities$CreatedDate</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>11/4/2022 12:00 AM</value>
        </criteriaItems>
        <criteriaItems>
            <column>Campaign.AccountCampaignMembers.Opportunities$StageName</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Closed Won</value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Campaign$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Q4:22 ABM Retargeting Speed-to-Won</name>
    <params>
        <name>scopeid</name>
        <value></value>
    </params>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Campaigns_with_Account_Opps__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <sortColumn>Campaign.AccountCampaignMembers.Opportunities$StageName</sortColumn>
    <sortOrder>Asc</sortOrder>
    <timeFrameFilter>
        <dateColumn>Campaign$CreatedDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
