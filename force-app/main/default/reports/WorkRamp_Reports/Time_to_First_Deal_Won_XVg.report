<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>WorkRamp_Assignment__c.Score__c:SUM / RowCount</calculatedFormula>
        <datatype>number</datatype>
        <description>Score as Number</description>
        <developerName>FORMULA1</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Score</masterLabel>
        <scale>0</scale>
    </aggregates>
    <columns>
        <field>User.WorkRamp_Assignments__r$Name</field>
    </columns>
    <columns>
        <field>User.WorkRamp_Assignments__r$CompletionDate__c</field>
    </columns>
    <columns>
        <field>User$CreatedDate</field>
    </columns>
    <columns>
        <field>User*User$First_Deal_Won_Date__c</field>
    </columns>
    <columns>
        <aggregateTypes>Average</aggregateTypes>
        <field>CDF1</field>
    </columns>
    <columns>
        <aggregateTypes>Average</aggregateTypes>
        <field>User.WorkRamp_Assignments__r$Score__c</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula>User.First_Deal_Won_Date__c - DATEVALUE(User.CreatedDate)</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Time To First Deal</label>
        <scale>0</scale>
    </customDetailFormulas>
    <description>Created Date = user creation date in Salesforce.  First Deal Won Date may be before the user&apos;s creation date if they were assigned an opp older than their user that was then closed won.  Record Count = # completed assignments per user.</description>
    <filter>
        <criteriaItems>
            <column>User.WorkRamp_Assignments__r$CompletionDate__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <column>User*User$First_Deal_Won_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <column>User.WorkRamp_Assignments__r$Score__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>0.0</value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>User$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Time to First Deal Won</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Users_with_WorkRamp_Assignments__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>User$ChatterAdoptionStageModifiedDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
