    <description>Average Score for completed Guide assignments for the Current Year.  Record Count = # of users for each assignment.</description>
    <filter>
        <criteriaItems>
            <column>WorkRamp_Assignment__c.PercentComplete__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>100.0</value>
        </criteriaItems>
        <criteriaItems>
            <column>WorkRamp_Assignment__c.WorkRampTrainingType__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Guide</value>
        </criteriaItems>
        <criteriaItems>
            <column>WorkRamp_Assignment__c.Score__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>0.0</value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>CUST_NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Average Score by Guide (Total Completed)</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>CustomEntity$WorkRamp_Assignment__c</reportType>
    <scope>organization</scope>
