<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>User.WorkRamp_Assignments__r$Name</field>
    </columns>
    <columns>
        <aggregateTypes>Average</aggregateTypes>
        <field>User.WorkRamp_Assignments__r$Score__c</field>
    </columns>
    <description>Average assignment scores for the Sales &amp; Partnerships! group. Record Count = # completed assignments per user</description>
    <filter>
        <criteriaItems>
            <column>User.WorkRamp_Assignments__r$Score__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>0.0</value>
        </criteriaItems>
        <criteriaItems>
            <column>User*User$WorkRampGroups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>!Sales &amp; Partnerships</value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>User$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Average Assignment Scores by S&amp;P</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Users_with_WorkRamp_Assignments__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>User.WorkRamp_Assignments__r$AssignedDate__c</dateColumn>
        <interval>INTERVAL_CURY</interval>
    </timeFrameFilter>
</Report>
