    <customDetailFormulas>
        <calculatedFormula>IF(
    OR(
        CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;Inbound&apos;),
        CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;C/L&apos;),
        CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;Closed Lost&apos;),
        CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;Reengagement&apos;),
        CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;REENGAGEMENT&apos;),
        CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;Circle Back&apos;),
        CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;ABANDONMENT&apos;)
    ),
    &apos;Warm&apos;,
    IF(
        OR(
            CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;G2&apos;),
            CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;Clearbit&apos;)
        ),
        &apos;Intent&apos;,
        &apos;Outbound&apos;
    )
)</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Cadence Type</label>
