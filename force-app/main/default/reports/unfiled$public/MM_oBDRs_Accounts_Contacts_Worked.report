<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>ACCOUNT.NAME:UNIQUE</calculatedFormula>
        <datatype>number</datatype>
