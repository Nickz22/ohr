        <masterLabel>#Enrollments</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(NOT(TEXT(TASK_TYPE:UNIQUE) = &quot;Prospect Action&quot;), 1, 0)</calculatedFormula>
