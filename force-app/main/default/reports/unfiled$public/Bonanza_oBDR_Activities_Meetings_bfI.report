    </columns>
    <customDetailFormulas>
        <calculatedFormula>IF(
    CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;DEMO&apos;), &apos;Demo&apos;,
    IF(
        CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;ADMIN SIGN&apos;), &apos;Admin&apos;,
        IF(
            CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;DORMANT&apos;), &apos;Dormant&apos;,
            IF(
                CONTAINS(Activity.SalesLoft1__SalesLoft_Cadence_Name__c, &apos;OBDR&apos;), &apos;Outbound&apos;,
                &apos;Other&apos;
            )
        )
    )
)</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Cadence Type</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>Number of meetings booked</description>
    <filter>
        <criteriaItems>
            <column>Activity.Assigned_To_Profile__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>BDR User</value>
        </criteriaItems>
        <criteriaItems>
            <column>SUBJECT</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Meeting,Demo</value>
        </criteriaItems>
        <criteriaItems>
            <column>ASSIGNED</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>Stefanos,Werf,Cantillana,Bindra</value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
