    <description>Report showing which &apos;Most Recent Cadence&apos; is sourcing the most Opportunity records as well as sum of revenue.</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.SalesLoft1__Most_Recent_Cadence_Name__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <column>WON</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>1</value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.SalesLoft1__Most_Recent_Cadence_Name__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
