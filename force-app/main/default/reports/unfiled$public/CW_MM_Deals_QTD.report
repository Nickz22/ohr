    <description>new reports using deal date and created by profile</description>
    <filter>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <column>Opportunity.Created_by_Profile__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>BDR user,Inside Sales Reps,Inbound,AE</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Company_Segment__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Mid-Market,Enterprise</value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.Created_By_Helper__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>CW MM Deals QTD</name>
