<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Account$Months_Since_First_Assisted_Setup_Date__c</field>
    </columns>
    <columns>
        <field>Account$Customer_First_Assisted_Setup_Date__c</field>
    </columns>
    <columns>
        <field>Account$LastActivityDate</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Account$Open_Opps__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Account.Opportunities$Amount</field>
    </columns>
    <columns>
        <field>Account$Account_Tier__c</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula>DATE(YEAR(ADDMONTHS(Account.Customer_First_Assisted_Setup_Date__c,3)),MONTH(ADDMONTHS(Account.Customer_First_Assisted_Setup_Date__c,3)),1) - 1</calculatedFormula>
        <dataType>DateOnly</dataType>
        <description>Last month for TMs to count towards NB</description>
        <developerName>CDF1</developerName>
        <label>NB Eligible Until</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>A list of Customers in their first 3 calendar months, where submitted TMs will count as New Business.</description>
    <filter>
        <criteriaItems>
            <column>Account$Months_Since_First_Assisted_Setup_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>2</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Opportunities$StageName</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Closed Lost</value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Account$Owner</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Account$Name</field>
        <sortOrder>Desc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <field>CDF1</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>New Biz customers in last month</name>
    <params>
        <name>co</name>
        <value>0</value>
    </params>
    <reportType>Accounts_with_Opportunities__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>false</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Account$CreatedDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
