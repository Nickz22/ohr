<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>SUBJECT</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula>FIRST_NAME &amp; &apos; &apos; &amp; LAST_NAME &amp; &apos; (&apos; &amp; ACCOUNT.NAME &amp; &apos;)&apos;</calculatedFormula>
        <dataType>Text</dataType>
        <description>Full name with Account</description>
        <developerName>CDF1</developerName>
        <label>Contact Name</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>This report displays a list of contacts and the number of emails they received, sorted highest to lowest.</description>
    <filter>
        <criteriaItems>
            <column>CALLOBJECT</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value></value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>CDF1</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>CALLOBJECT</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Most Emailed Contacts - Top 20</name>
    <params>
        <name>closed</name>
        <value>closed</value>
    </params>
    <params>
        <name>type</name>
        <value>t</value>
    </params>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>ContactActivity</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>COMPLETED_DATE_TIME</dateColumn>
        <interval>INTERVAL_LAST30</interval>
    </timeFrameFilter>
</Report>
