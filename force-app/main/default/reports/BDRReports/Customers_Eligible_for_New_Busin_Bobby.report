    <customDetailFormulas>
        <calculatedFormula>DATE(YEAR(ADDMONTHS(Account.Customer_First_Assisted_Setup_Date__c,3)),MONTH(ADDMONTHS(Account.Customer_First_Assisted_Setup_Date__c,3)),1) - 1</calculatedFormula>
        <dataType>DateOnly</dataType>
        <description>Last month for TMs to count towards NB</description>
        <developerName>CDF1</developerName>
        <label>NB Eligible Until</label>
        <scale>0</scale>
    </customDetailFormulas>
    <description>A list of Customers in their first 3 calendar months, where submitted TMs will count as New Business.</description>
    <filter>
