    </columns>
    <columns>
        <field>Opportunity.Use_Case__c</field>
    </columns>
    <columns>
        <field>Account.mk_customer_fit_segment__c</field>
    </columns>
    <columns>
        <field>Account.mk_customer_fit_signals__c</field>
    </columns>
    <columns>
        <field>Account.Clearbit_Intent_Details__c</field>
    </columns>
    <columns>
        <field>Account.G2_Buyer_Intent_Details__c</field>
    </columns>
    <columns>
        <field>CONTACT</field>
