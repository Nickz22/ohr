<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Sub_Status</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    OR(ISPICKVAL(Status, &quot;Nurture&quot;),ISPICKVAL(Status, &quot;Unqualified&quot;)),
    ISBLANK(TEXT(Sub_Status__c))
)</errorConditionFormula>
    <errorDisplayField>Sub_Status__c</errorDisplayField>
    <errorMessage>Fill in the Sub Status field.</errorMessage>
</ValidationRule>
