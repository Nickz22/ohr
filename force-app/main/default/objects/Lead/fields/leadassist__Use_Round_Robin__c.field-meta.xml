<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>leadassist__Use_Round_Robin__c</fullName>
    <deprecated>false</deprecated>
    <description>Determines whether Super Round Robin is triggered to do lead assignment. Replaces Round_Robin__c from Version 3.</description>
    <externalId>false</externalId>
    <inlineHelpText>Determines whether Super Round Robin is triggered to do lead assignment.  Set to TRUE for SRR to run on lead creation/update.  Set to FALSE to ignore Round Robin assignment. Will automatically revert to ASSIGNED if successful match leads to assignment, otherwise will revert to NOMATCH</inlineHelpText>
    <label>Use Round Robin</label>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <trackHistory>false</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>TRUE</fullName>
                <default>false</default>
                <label>TRUE</label>
            </value>
            <value>
                <fullName>FALSE</fullName>
                <default>true</default>
                <label>FALSE</label>
            </value>
            <value>
                <fullName>ASSIGNED</fullName>
                <default>false</default>
                <label>ASSIGNED</label>
            </value>
            <value>
                <fullName>NOMATCH</fullName>
                <default>false</default>
                <label>NOMATCH</label>
            </value>
            <value>
                <fullName>QUEUED</fullName>
                <default>false</default>
                <label>QUEUED</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
