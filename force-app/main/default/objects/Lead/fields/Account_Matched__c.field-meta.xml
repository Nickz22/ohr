<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_Matched__c</fullName>
    <description>Formula field, indicating if lead was successfully matched to an Account Record</description>
    <externalId>false</externalId>
    <formula>Not(IsBlank(AccountId__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Account Matched</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
