<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Changing_Account_Source</fullName>
    <active>false</active>
    <description>Only system admins can change Account Source once it has been set.</description>
    <errorConditionFormula>NOT(ISBLANK(TEXT(PRIORVALUE(AccountSource))))
&amp;&amp; ISCHANGED(AccountSource)
&amp;&amp; $Profile.Name &lt;&gt; &quot;System Administrator&quot;</errorConditionFormula>
    <errorDisplayField>AccountSource</errorDisplayField>
    <errorMessage>You may not change the Account Source.</errorMessage>
</ValidationRule>
