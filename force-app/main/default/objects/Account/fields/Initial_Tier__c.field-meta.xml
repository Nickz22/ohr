<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Initial_Tier__c</fullName>
    <externalId>false</externalId>
    <formula>IF(TMs_to_Hire_by_M3__c &gt;= 15 || ISPICKVAL(Strategic_Logo__c, &quot;Yes&quot;), &quot;Tier 1&quot;,
IF(TMs_to_Hire_by_M3__c &gt;= 5, &quot;Tier 2&quot;,
IF(TMs_to_Hire_by_M3__c &lt; 5, &quot;Tier 3&quot;, &quot;&quot;)
)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Indicate the entry-level tier of the account upon the initial review or transfer.</inlineHelpText>
    <label>Initial Tier</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
