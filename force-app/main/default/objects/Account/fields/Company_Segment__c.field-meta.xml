<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Company_Segment__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(NumberOfEmployees) || NumberOfEmployees = 0, &quot;Unknown&quot;,
   IF(NumberOfEmployees &lt;  249, &quot;SMB&quot;,
         IF(NumberOfEmployees &gt;= 250 &amp;&amp; NumberOfEmployees &lt;= 1000, &quot;Mid-Market&quot;,
            &quot;Enterprise&quot;
         )
      )
   )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Company Segment</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
