IF(BLANKVALUE(IF(Company_Employees_Clearbit__c = 0, NULL,Company_Employees_Clearbit__c),NumberOfEmployees) &gt; 5000, &quot;Enterprise&quot;, &quot;&quot;
)))

)</formula>
