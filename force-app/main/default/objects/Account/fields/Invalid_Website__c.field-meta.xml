<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Invalid_Website__c</fullName>
    <description>TRUE if the Website is invalid (contains a space or does not contain a period)</description>
    <externalId>false</externalId>
    <formula>OR(
    CONTAINS(Website,&quot; &quot;),
    NOT(CONTAINS(Website,&quot;.&quot;))
)</formula>
    <label>Invalid Website</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
