<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Health_Score_formula__c</fullName>
    <description>Displays an image based on the Health Score.</description>
    <externalId>false</externalId>
    <formula>IMAGE( 
CASE( Health_Score__c, 
&quot;Green&quot;, &quot;/img/samples/flag_green.gif&quot;,
&quot;Yellow&quot;, &quot;/img/samples/flag_yellow.gif&quot;,
&quot;Red&quot;, &quot;/img/samples/flag_red.gif&quot;, 
&quot;Healthy&quot;, &quot;/img/samples/flag_green.gif&quot;,
&quot;Neutral&quot;, &quot;/img/samples/flag_yellow.gif&quot;,
&quot;At Risk&quot;, &quot;/img/samples/flag_red.gif&quot;, 
&quot;/s.gif&quot;), 
&quot;Health Score&quot;)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Account Health (flag)</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
