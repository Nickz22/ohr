<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_Won__c</fullName>
    <description>Captures the Amount of the Opportunity when it is Won</description>
    <externalId>false</externalId>
    <formula>IF (
  IsWon = TRUE,
  Amount,
  0
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Captures the Amount of the Opportunity when it is Won</inlineHelpText>
    <label>Amount Won</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
