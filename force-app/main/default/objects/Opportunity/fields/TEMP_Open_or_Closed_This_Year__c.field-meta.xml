<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TEMP_Open_or_Closed_This_Year__c</fullName>
    <description>Iceberg reporting field</description>
    <externalId>false</externalId>
    <formula>OR(
    NOT(IsClosed),
    IsClosed &amp;&amp; CloseDate &gt;= DATE(2024,01,01)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>TEMP - Open or Closed This Year</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
