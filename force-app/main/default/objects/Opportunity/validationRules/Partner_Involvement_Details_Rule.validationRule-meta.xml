<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Partner_Involvement_Details_Rule</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Partner_Involvement_Detail__c, &quot;&quot;),
NOT(ISBLANK(TEXT(Partner_Involvement_Type__c)))
)</errorConditionFormula>
    <errorMessage>Partner Involvement Detail field cannot be empty if Partner Involvement Type field is selected</errorMessage>
</ValidationRule>
