<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lost_to_Comp_Name_required</fullName>
    <active>false</active>
    <description>&quot;Lost to Competitor (Name)&quot; is required when &quot;Lost to Competitor&quot; = yes</description>
    <errorConditionFormula>AND(
ISPICKVAL(Lost_to_Comp__c, &quot;yes&quot;),
ISBLANK(Lost_to_Competitor_Name__c),
ISCHANGED(Lost_to_Comp__c)
)</errorConditionFormula>
    <errorMessage>&quot;Lost to Competitor (Name)&quot; is required.</errorMessage>
</ValidationRule>
