<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Moving_Past_Discovery</fullName>
    <active>true</active>
    <errorConditionFormula>TEXT(PRIORVALUE(StageName)) = &quot;Prospecting&quot;
&amp;&amp;
!ISCHANGED(RecordTypeId)
&amp;&amp;
ISCHANGED(StageName)
&amp;&amp; 
!ISPICKVAL(StageName,&quot;Closed Lost&quot;)
&amp;&amp;
Meeting_Status_Demodesk__c != &quot;Held&quot;
&amp;&amp;
!ISPICKVAL(Meeting_Outcome__c,&quot;Qualified&quot;)</errorConditionFormula>
    <errorDisplayField>StageName</errorDisplayField>
    <errorMessage>To advance this opp, ensure the &quot;Meeting Outcome&quot; field = Qualified.</errorMessage>
</ValidationRule>
