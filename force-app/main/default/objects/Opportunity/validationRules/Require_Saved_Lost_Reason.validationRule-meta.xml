<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Saved_Lost_Reason</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISCHANGED(StageName),
    RecordType.DeveloperName = &quot;Churn_Contraction_Risk&quot;,
    IsClosed,
    ISBLANK(Saved_Lost_Reason__c)
)</errorConditionFormula>
    <errorDisplayField>Saved_Lost_Reason__c</errorDisplayField>
    <errorMessage>Please fill in the Saved/Lost Reason.</errorMessage>
</ValidationRule>
